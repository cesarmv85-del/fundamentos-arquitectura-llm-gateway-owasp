# Copie a .env:  cp .env.example .env
# NUNCA suba el archivo .env real al repositorio (.gitignore ya lo excluye).
# desarrollo | produccion (produccion exige todas las mitigaciones activas)
ENTORNO=desarrollo

# ── Proveedores upstream ───────────────────────────────────────────────
# simulado | simulado_respaldo | openai | anthropic | google | ollama
PROVEEDOR_PRINCIPAL=simulado
PROVEEDOR_RESPALDO=
# Deje vacías las keys que no use. Alternativa recomendada: *_FILE apuntando a un
# secreto montado (Docker secrets / Kubernetes / Google Secret Manager):
#   OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MODELO_OPENAI=gpt-4o-mini
MODELO_ANTHROPIC=claude-haiku-4-5
MODELO_GOOGLE=gemini-2.5-flash
MODELO_OLLAMA=llama3.2
TIMEOUT_UPSTREAM_SEG=20

# ── Clientes del gateway (solo HASH SHA-256, nunca la clave) ──────────
# Generar con: python scripts/generar_clave_cliente.py equipo_soporte
GATEWAY_CLIENT_KEYS_SHA256=

# ── LLM10 · Unbounded Consumption ─────────────────────────────────────
RATE_LIMIT=5/minute
# clave (recomendado) | ip (solo para demostrar el error común)
RATE_LIMIT_POR=clave
# en producción con varias réplicas: redis://host:6379
RATE_LIMIT_STORAGE_URI=memory://
MAX_TOKENS_TECHO=512
MAX_CARACTERES_MENSAJE=4000
MAX_BYTES_BODY=16384

# ── Logging / CORS ────────────────────────────────────────────────────
LOG_ARCHIVO=logs/gateway.jsonl
LOG_CONSOLA=true
CORS_ORIGINS=http://localhost:5173

# ── Interruptores de mitigación (SOLO para la demo antes/después) ─────
MITIGACION_LLM01=true
MITIGACION_LLM02=true
MITIGACION_LLM07=true
MITIGACION_LLM10=true
# vacío | timeout | error_500 | error_con_clave
SIMULAR_FALLA_UPSTREAM=
